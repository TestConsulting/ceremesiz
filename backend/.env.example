NODE_ENV=production
PORT=4000

# Langes zufälliges Secret, z. B. erzeugt mit:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=<langes-zufaelliges-secret>

# Erlaubte Ursprünge für den Login (kommagetrennt)
FRONTEND_ORIGINS=https://ceremesiz-holding.de,https://www.ceremesiz-holding.de

# Anzahl Proxies vor Express (Nginx = 1)
TRUST_PROXY=1

# Max. fehlgeschlagene Logins pro IP in 15 Minuten
LOGIN_RATE_LIMIT=10

# Astra FIBU ist ohne Konfiguration deaktiviert.
# Echte Pfade/Kontozuordnungen unter backend/data/ (nicht in Git) konfigurieren.
# Im Produktionscontainer z. B. /app/backend/data/fibu.config.json
# FIBU_CONFIG_PATH=C:/absoluter/Pfad/backend/data/fibu.config.json
# Für Portal -> Windows: Portal-Konfiguration mode=remote, Windows-Konfiguration mode=local.
# FIBU_PORTAL_URL=https://www.ceremesiz-holding.de
# FIBU_RUNNER_COMPANY=tc
# FIBU_RUNNER_DB=C:/absoluter/Pfad/backend/data/fibu-runner.db
# FIBU_RUNNER_SECRET auf Portal und Windows separat sicher hinterlegen (nicht in Git).
# Erzeugen: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
