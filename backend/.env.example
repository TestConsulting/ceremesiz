NODE_ENV=production
PORT=4000

# Langes zufälliges Secret, z. B. erzeugt mit:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=<langes-zufaelliges-secret>

# Erlaubte Ursprünge für den Login (kommagetrennt)
FRONTEND_ORIGINS=https://ceremesiz-holding.de,https://www.ceremesiz-holding.de

# Anzahl Proxies vor Express (Nginx = 1)
TRUST_PROXY=1

# Max. fehlgeschlagene Logins pro IP in 15 Minuten
LOGIN_RATE_LIMIT=10
